<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
	<RazorEngineCore_TemplateDir Condition="'$(RazorEngineCore_TemplateDir)' == ''">$(MSBuildProjectDirectory)\Templates</RazorEngineCore_TemplateDir>
	<RazorEngineCore_IncludeDebuggingInfo Condition="'$(RazorEngineCore_IncludeDebuggingInfo)' == ''">false</RazorEngineCore_IncludeDebuggingInfo>
	<RazorEngineCore_EnableCompileTemplates Condition="'$(RazorEngineCore_EnableCompileTemplates)' == ''">false</RazorEngineCore_EnableCompileTemplates>
  </PropertyGroup>

  <UsingTask TaskName="RazorEngineCore.Tasks.CompileTemplatesTask"
			 AssemblyFile="$(MSBuildThisFileDirectory)..\lib\net10.0\RazorEngineCore.dll"
			 Runtime="NET"
			 Architecture="x64"/>
	
  <UsingTask TaskName="RazorEngineCore.Tasks.CleanTemplatesBuildTask"
			 AssemblyFile="$(MSBuildThisFileDirectory)..\lib\net10.0\RazorEngineCore.dll"
			 Runtime="NET"
			 Architecture="x64"/>

  <Target Name="RazorEngineCoreCompileTemplates" BeforeTargets="BeforeBuild;CoreCompile" Condition="'$(RazorEngineCore_EnableCompileTemplates)' == 'true'">
	<CompileTemplatesTask TemplateDir="$(RazorEngineCore_TemplateDir)" IncludeDebuggingInfo="$(RazorEngineCore_IncludeDebuggingInfo)">
		<Output TaskParameter="GeneratedResources" ItemName="DynamicResources" />
	</CompileTemplatesTask>

	<ItemGroup>
		<EmbeddedResource Include="@(DynamicResources)" />
	</ItemGroup>

  </Target>
	
  <Target Name="RazorEngineCoreCleanTemplatesBuild" AfterTargets="Clean" Condition="'$(RazorEngineCore_EnableCompileTemplates)' == 'true'">
	<CleanTemplatesBuildTask TemplateDir="$(RazorEngineCore_TemplateDir)" />
  </Target>

</Project>
