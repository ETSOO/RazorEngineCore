<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
	<RazorEngineCore_TemplateDir Condition="'$(RazorEngineCore_TemplateDir)' == ''">$(MSBuildProjectDirectory)\Templates</RazorEngineCore_TemplateDir>
	<RazorEngineCore_EnableCompileTemplates Condition="'$(RazorEngineCore_EnableCompileTemplates)' == ''">false</RazorEngineCore_EnableCompileTemplates>
  </PropertyGroup>

  <UsingTask TaskName="RazorEngineCore.Tasks.CompileTemplatesTask"
			 AssemblyFile="$(MSBuildThisFileDirectory)..\lib\net10.0\RazorEngineCore.dll"
			 Runtime="*"
			 Architecture="*"/>
	
  <UsingTask TaskName="RazorEngineCore.Tasks.ClearTemplatesBuildTask"
			 AssemblyFile="$(MSBuildThisFileDirectory)..\lib\net10.0\RazorEngineCore.dll"
			 Runtime="*"
			 Architecture="*"/>

  <Target Name="RazorEngineCoreCompileTemplates" BeforeTargets="BeforeBuild" Condition="'$(RazorEngineCore_EnableCompileTemplates)' == 'true'">
	<CompileTemplatesTask TemplateDir="$(RazorEngineCore_TemplateDir)" />
  </Target>
	
  <Target Name="RazorEngineCoreClearTemplatesBuild" AfterTargets="Clear" Condition="'$(RazorEngineCore_EnableCompileTemplates)' == 'true'">
	<ClearTemplatesBuildTask TemplateDir="$(RazorEngineCore_TemplateDir)" />
  </Target>

</Project>
